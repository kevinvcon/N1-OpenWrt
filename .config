      - name: Verify Target and SSL Dependencies
        run: |
          cd openwrt
          mkdir -p staging_dir/host
          touch staging_dir/host/.prereq-build
          make defconfig
          
          if ! grep -q "^CONFIG_TARGET_armvirt_64_Default=y" .config; then
            echo "❌ 致命错误：Target 配置未生效！"
            grep '^CONFIG_TARGET_' .config
            exit 1
          fi
          if ! grep -q "^CONFIG_PACKAGE_uhttpd=y" .config || ! grep -q "^CONFIG_PACKAGE_libustream-openssl=y" .config; then
            echo "❌ 致命错误：uhttpd 或 SSL 依赖丢失！"
            exit 1
          fi
          echo "✅ Target 与 SSL 依赖验证通过！"
